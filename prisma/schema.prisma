generator client {
  provider = "prisma-client-js"
  output   = "./generated/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Adresses {
  adresse_id Int     @id @default(autoincrement())
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int
  type       String  // facturation, livraison, rendezvous
  rue        String
  code_postal String
  ville      String
  pays       String? @default("France")

  commandes   Commande[]
  rendezvous  Rendezvous[]
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  prenom    String
  nom       String
  adresse   Adresses[]
  commandes Commande[]
  rendezvous Rendezvous[]
}

model Commande {
  commandes_id  Int      @id @default(autoincrement())
  user          User     @relation(fields: [user_id], references: [id])
  user_id       Int
  adresse       Adresses @relation(fields: [adresse_id], references: [adresse_id])
  adresse_id    Int?
  date          DateTime @default(now())
  status        String
  total         Float

  paiement     Paiement?
  produits     Commande_Produit[]
}
