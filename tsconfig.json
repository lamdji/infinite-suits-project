{ 
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext", 
    "target": "ESNext",
    "moduleResolution": "Node", 
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "strictNullChecks": false, 
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./",
    "paths": {
      "@/components/*": ["src/api/components/*"],
      "@/dataTailors": ["lib/dataTailors"],
      "@/data":["public/data.json"],
      "@/lib/*": ["lib/*"],
      "@/context/*": ["src/context/*"],
      "@/types/*": ["src/types/*"],
      "@/TailorList/*":["src/app/components/TailorList"],
      

    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "testPrisma/test-prisma.ts",
    "tests/utilitaires/testbcrypt.js"
  ],
  "exclude": ["node_modules"]
}
